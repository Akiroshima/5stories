<Window x:Class="DomModel.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tetris Game"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Игровое поле -->
        <Grid Grid.Column="0" Background="#2D2D2D" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Canvas для отображения поля -->
            <Canvas x:Name="GameCanvas" 
                    Grid.Row="0"
                    Background="#3E3E3E"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            <!-- Информация о состоянии -->
            <TextBlock Grid.Row="1" 
                       Text="{Binding GameStatus}" 
                       Foreground="White"
                       TextAlignment="Center"
                       Margin="10"/>
        </Grid>

        <!-- Панель управления и рекордов -->
        <StackPanel Grid.Column="1" Margin="10" Background="#2D2D2D">
            <!-- Счёт и уровень -->
            <StackPanel Margin="10">
                <TextBlock Text="Счёт:" Foreground="White" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{Binding CurrentScore}" Foreground="#00FF00" FontSize="20" FontWeight="Bold"/>

                <TextBlock Text="Очищенные линии:" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding LinesCleared}" Foreground="#00FF00" FontSize="20" FontWeight="Bold"/>

                <TextBlock Text="Уровень:" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding Level}" Foreground="#00FF00" FontSize="20" FontWeight="Bold"/>
            </StackPanel>

            <!-- Кнопки управления -->
            <StackPanel Margin="10">
                <TextBlock Text="Управление:" Foreground="White" FontSize="14" FontWeight="Bold"/>
                
                <Button Command="{Binding StartGameCommand}" 
                        Content="Новая игра" 
                        Margin="0,10,0,5"
                        Padding="10"
                        Background="#0078D4"
                        Foreground="White"/>
                
                <Button Command="{Binding PauseGameCommand}" 
                        Content="Пауза" 
                        Margin="0,5,0,5"
                        Padding="10"
                        Background="#F44747"
                        Foreground="White"/>
                
                <Button Command="{Binding ResumeGameCommand}" 
                        Content="Продолжить" 
                        Margin="0,5,0,5"
                        Padding="10"
                        Background="#07B92A"
                        Foreground="White"/>

                <TextBlock Text="Клавиши:" Foreground="White" FontSize="12" Margin="0,15,0,5"/>
                <TextBlock Text="← / → : Движение" Foreground="#CCCCCC" FontSize="11"/>
                <TextBlock Text="↓ : Быстрое падение" Foreground="#CCCCCC" FontSize="11"/>
                <TextBlock Text="Space : Поворот" Foreground="#CCCCCC" FontSize="11"/>
            </StackPanel>

            <!-- Таблица рекордов -->
            <StackPanel Margin="10">
                <TextBlock Text="Таблица рекордов:" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,15,0,10"/>
                
                <DataGrid ItemsSource="{Binding LeaderBoard}"
                          Background="#3E3E3E"
                          Foreground="White"
                          BorderBrush="#555555"
                          IsReadOnly="True"
                          Height="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Имя" Binding="{Binding PlayerName}" Width="*"/>
                        <DataGridTextColumn Header="Счёт" Binding="{Binding Score}" Width="80"/>
                        <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>